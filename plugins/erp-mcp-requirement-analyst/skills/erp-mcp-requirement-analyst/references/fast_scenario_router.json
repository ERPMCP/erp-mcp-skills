{
  "version": "2.0",
  "first_round_policy": {
    "max_local_files": 2,
    "read_full_capability_guide": false,
    "inspect_live_schema": false,
    "call_erp_business_tools": false,
    "render_then_stop": true
  },
  "scenarios": [
    {
      "id": "house_new_listing_count",
      "keywords_any": [
        "新上房源数量",
        "新增房源数量",
        "新上多少套",
        "新增多少套"
      ],
      "required_keyword_groups": [
        ["新上房源", "新增房源"],
        ["数量", "多少套", "多少"]
      ],
      "forbidden_keywords": ["挂牌均价", "挂牌均单价"],
      "template": "house_new_listing_count_fast.json",
      "first_round_action": "render_requirement_wizard_and_wait",
      "customer_progress": "请先确认房源业务类型；确认后我会立即用官方统计生成数字和实时看板。",
      "forbidden_before_confirmation": [
        "queryRptData",
        "queryContractFinanceData",
        "listHouseByCondition",
        "getHouseByHouseNo"
      ],
      "after_confirmation": [
        "mark_definition_confirmed",
        "call_showErpDashboard_for_summary",
        "return_verified_summary_in_widget",
        "do_not_fetch_details_until_metric_click"
      ]
    },
    {
      "id": "house_new_listing_price",
      "keywords_any": [
        "新上房源",
        "新增房源",
        "挂牌均价",
        "挂牌均单价"
      ],
      "required_keyword_groups": [
        ["新上房源", "新增房源"],
        ["挂牌均价", "挂牌均单价"]
      ],
      "template": "house_new_listing_price_fast.json",
      "first_round_action": "render_requirement_wizard_and_wait",
      "customer_progress": "请先确认业务类型和均价方式；确认后我会先显示新增数量，均价和明细按需查询。",
      "forbidden_before_confirmation": [
        "queryRptData",
        "queryContractFinanceData",
        "listHouseByCondition",
        "getHouseByHouseNo",
        "getSectionMarketBaseInfo",
        "getSectionMarketData",
        "listHotSection"
      ],
      "after_confirmation": [
        "mark_definition_confirmed",
        "call_showErpDashboard_for_summary",
        "return_verified_summary_in_widget",
        "defer_reference_price_until_requested",
        "do_not_fetch_details_until_metric_click"
      ]
    }
  ]
}
